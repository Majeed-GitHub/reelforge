# --- Reelforge local configuration -------------------------------------------
# Copy to .env to change defaults. Everything here is optional: Reelforge runs
# fully offline with no keys at all (offline Windows TTS + scripted planner).

# Ports
REELFORGE_API_PORT=4400
REELFORGE_WEB_PORT=4401
REELFORGE_DEMO_PORT=4402

# Where the database, videos, screenshots and audio live.
# REELFORGE_DATA_DIR=./data

# --- Planner (the "brain") ---------------------------------------------------
# Left empty: the offline scripted planner is used, which understands common
# flows (sign in, navigate, create, invite, upgrade) and narrates them.
# Set any OpenAI-compatible endpoint to get a real reasoning planner.
# REELFORGE_LLM_BASE_URL=https://api.openai.com/v1
# REELFORGE_LLM_API_KEY=sk-...
# REELFORGE_LLM_MODEL=gpt-4.1-mini

# --- Narration ---------------------------------------------------------------
# auto = openai (if key) -> edge-tts (if installed) -> Windows SAPI -> silent
# REELFORGE_TTS_PROVIDER=auto
# REELFORGE_TTS_VOICE=Microsoft Zira Desktop

# --- Metering ----------------------------------------------------------------
# Off by default so a self-hosted instance never blocks on credits.
# REELFORGE_ENFORCE_CREDITS=false
# REELFORGE_FREE_MINUTES=5
# REELFORGE_CONCURRENCY=3
