{
  "name": "reelforge",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Reelforge — an open, self-hosted clone of Screenforge Director: give it a URL and one sentence, it drives your product in a real browser and publishes a narrated video, help article and in-app guide from one Product Graph.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "api": "node --env-file-if-exists=.env packages/api/src/server.ts",
    "worker": "node --env-file-if-exists=.env packages/api/src/worker/main.ts",
    "web": "vite --config packages/web/vite.config.ts",
    "demosite": "node apps/demo-site/server.ts",
    "cli": "node --env-file-if-exists=.env packages/cli/src/index.ts",
    "dev": "node scripts/dev.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.ts",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "fastify": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "marked": "^15.0.0",
    "playwright": "^1.56.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
